# PayFlow Environment Configuration
# Copy this file to .env and insert your Twilio credentials if available.
# If left unset or blank, PayFlow will automatically operate in Simulation Sandbox Mode.

PORT=3000
NODE_ENV=development

# Twilio API Credentials (keep secret - never commit to public git)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional Twilio Voice TwiML URL or custom message
TWILIO_VOICE_MESSAGE="Hello, this is PayFlow Security Alert. Your transaction was processed successfully."
